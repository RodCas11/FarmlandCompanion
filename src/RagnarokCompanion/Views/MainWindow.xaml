<Window x:Class="RagnarokCompanion.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RagnarokCompanion.Views" Title="Farmland Companion" Icon="/Assets/AppIcon.ico" Width="1160" Height="820" MinWidth="940" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" Background="Transparent" Style="{StaticResource {x:Type Window}}">
 <Border Background="#0D111C" CornerRadius="12" BorderBrush="#30384B" BorderThickness="1"><Grid>
  <DockPanel x:Name="FullView">
   <Grid DockPanel.Dock="Top" Height="40" Background="#141928" MouseLeftButtonDown="DragHeader"><Image Source="/Assets/AppIcon.ico" Width="20" Height="20" HorizontalAlignment="Left" Margin="12,0"/><TextBlock Text="Farmland Companion" Margin="40,0" FontSize="12" Foreground="#9AA6BF"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" ToolTip="Minimizar" Click="Minimize" Padding="12,3"/><Button Content="□" ToolTip="Maximizar / restaurar" Click="Maximize" Padding="12,3"/><Button Content="×" ToolTip="Fechar" Click="CloseAppWindow" Padding="12,3"/></StackPanel></Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#141928" Padding="16,24"><DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="FARMLAND" FontWeight="Bold" FontSize="19"/><TextBlock Text="COMPANION" Foreground="#A89BEF" FontSize="10" Margin="0,3,0,24"/></StackPanel>
     <TextBlock DockPanel.Dock="Bottom" Text="Timers locais • Farmland" FontSize="10" Foreground="#9AA6BF"/>
     <StackPanel>
      <RadioButton Content="Início" GroupName="Navigation" Style="{StaticResource NavItem}" IsChecked="{Binding Page, Converter={StaticResource PageIndex}, ConverterParameter=0}" Command="{Binding NavigateCommand}" CommandParameter="0"/>
      <RadioButton Content="MVPs" GroupName="Navigation" Style="{StaticResource NavItem}" IsChecked="{Binding Page, Converter={StaticResource PageIndex}, ConverterParameter=1}" Command="{Binding NavigateCommand}" CommandParameter="1"/>
      <RadioButton Content="Histórico" GroupName="Navigation" Style="{StaticResource NavItem}" IsChecked="{Binding Page, Converter={StaticResource PageIndex}, ConverterParameter=2}" Command="{Binding NavigateCommand}" CommandParameter="2"/>
      <RadioButton Content="Configurações" GroupName="Navigation" Style="{StaticResource NavItem}" IsChecked="{Binding Page, Converter={StaticResource PageIndex}, ConverterParameter=3}" Command="{Binding NavigateCommand}" CommandParameter="3"/>
      <RadioButton Content="SpotLight" GroupName="Navigation" Style="{StaticResource NavItem}" IsChecked="{Binding Page, Converter={StaticResource PageIndex}, ConverterParameter=4}" Command="{Binding NavigateCommand}" CommandParameter="4"/><RadioButton Content="Eventos" GroupName="Navigation" Style="{StaticResource NavItem}" IsChecked="{Binding Page, Converter={StaticResource PageIndex}, ConverterParameter=5}" Command="{Binding NavigateCommand}" CommandParameter="5"/><Button Content="Modo compacto ↗" Command="{Binding CompactCommand}" Style="{StaticResource Primary}" Padding="8,11" Margin="0,30,0,0"/>
     </StackPanel>
    </DockPanel></Border>
    <DockPanel Grid.Column="1" Margin="24,20,18,12">
     <Border DockPanel.Dock="Bottom" Padding="10,8" Background="#141928" CornerRadius="6" Margin="0,10,0,0"><TextBlock Text="{Binding Feedback}" Foreground="#9AA6BF" FontSize="11" TextWrapping="Wrap"/></Border>
     <TabControl SelectedIndex="{Binding Page}" Background="Transparent" BorderThickness="0"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
      <TabItem><views:HomeView/></TabItem>
      <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="MVPs" Style="{StaticResource Title}"/><views:CatalogView DataContext="{Binding Catalog}"/><TextBlock Text="Timers ativos" FontSize="20" Margin="0,20,0,8"/><ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedMvp}" ItemTemplate="{StaticResource MvpCard}" MaxHeight="320"/><Expander Header="Cadastro manual e correções" IsExpanded="{Binding EditorExpanded}" Margin="0,12"><views:ManualMvpView/></Expander></StackPanel></ScrollViewer></TabItem>
      <TabItem><DockPanel><TextBlock DockPanel.Dock="Top" Text="Histórico" Style="{StaticResource Title}"/><TextBlock DockPanel.Dock="Top" Text="Entradas na mina, mortes registradas e alertas." Style="{StaticResource Muted}"/><ListBox ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryCard}"/></DockPanel></TabItem>
      <TabItem><views:SettingsView/></TabItem><TabItem><views:SpotlightView DataContext="{Binding Spotlight}"/></TabItem><TabItem><views:EventsView DataContext="{Binding Events}"/></TabItem>
     </TabControl>
    </DockPanel>
   </Grid>
  </DockPanel>
  <views:CompactView x:Name="CompactContent" Visibility="Collapsed"/>
 </Grid></Border>
</Window>
