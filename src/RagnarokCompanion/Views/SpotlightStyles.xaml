<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1C2333"/><Setter Property="Foreground" Value="#AAB6D0"/><Setter Property="Padding" Value="9,10"/><Setter Property="BorderBrush" Value="#30384B"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="FontSize" Value="11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border x:Name="Header" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><DockPanel><TextBlock x:Name="SortGlyph" DockPanel.Dock="Right" Margin="3,0" FontSize="9"/><ContentPresenter/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Header" Property="Background" Value="#2D3450"/></Trigger><Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortGlyph" Property="Text" Value="↑"/></Trigger><Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortGlyph" Property="Text" Value="↓"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#DCE3F2"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#A88EFF"/></Trigger></Style.Triggers></Style>
 <Style TargetType="DataGridRow"><Setter Property="Background" Value="#141A28"/><Setter Property="Foreground" Value="#DCE3F2"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ToolTipService.InitialShowDelay" Value="450"/><Setter Property="ToolTipService.ShowDuration" Value="12000"/><Setter Property="ToolTip"><Setter.Value><ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><StackPanel><TextBlock Text="{Binding Map.Name}" FontWeight="SemiBold" Margin="0,0,0,7" TextWrapping="Wrap"/><TextBlock Text="Monstros" Foreground="#BDA9FF" FontSize="11" Margin="0,0,0,4"/><TextBlock Text="{Binding Map.MonsterInfo}" TextWrapping="Wrap" MaxWidth="380"/></StackPanel></ToolTip></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding Suitable}" Value="True"><Setter Property="Background" Value="#18342F"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#262E43"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#393151"/></Trigger></Style.Triggers></Style>
 <Style x:Key="RecommendedLevel" TargetType="TextBlock"><Setter Property="Foreground" Value="#BDA9FF"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
</ResourceDictionary>
