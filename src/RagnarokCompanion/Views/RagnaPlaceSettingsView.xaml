<UserControl x:Class="RagnarokCompanion.Views.RagnaPlaceSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource Card}"><StackPanel>
  <TextBlock Text="Integração RagnaPlace" FontSize="20"/>
  <TextBlock Text="Consultas opcionais online • timers e mineração permanecem locais" Style="{StaticResource Muted}"/>
  <TextBlock Text="API Key"/><PasswordBox x:Name="KeyInput" MaxLength="4096" Padding="10,8" Margin="0,6" Background="#0F1422" Foreground="#EDF0FA" BorderBrush="#354057"/>
  <WrapPanel><Button Content="Proteger e salvar chave" Click="SaveKey"/><Button Content="Apagar chave" Command="{Binding DeleteKeyCommand}"/></WrapPanel>
  <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding AuthStatus}" Foreground="#71C8F4"/>
  <TextBlock Text="Gateway Renewal (não representa as configurações do Farmland)" Margin="0,16,0,4"/>
  <ComboBox ItemsSource="{Binding Gateways}" SelectedValue="{Binding GatewaySlug}" SelectedValuePath="Slug" DisplayMemberPath="Label"/>
  <WrapPanel><Button Content="Atualizar gateways" Command="{Binding LoadGatewaysCommand}"/><Button Content="Testar conexão autenticada" Command="{Binding TestConnectionCommand}"/></WrapPanel>
  <TextBlock Text="Última consulta bem-sucedida:" Style="{StaticResource Muted}"/><TextBlock Text="{Binding LastSync}"/>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10" Foreground="#BEA7FF"/>
  <TextBlock Text="Uso pessoal e não comercial. Sem consultas em massa. Cache de respostas apenas na sessão; favoritos, configurações escolhidas e timers ficam disponíveis offline." Style="{StaticResource Muted}"/>
  <TextBlock><Hyperlink NavigateUri="https://ragnaplace.com/pt/api" RequestNavigate="OpenAttribution">Dados fornecidos por RagnaPlace</Hyperlink></TextBlock>
 </StackPanel></Border>
</UserControl>
