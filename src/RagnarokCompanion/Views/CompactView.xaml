<UserControl x:Class="RagnarokCompanion.Views.CompactView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:RagnarokCompanion.ViewModels" xmlns:models="clr-namespace:RagnarokCompanion.Models">
 <UserControl.Resources>
  <vm:CompactTabConverter x:Key="CompactTabEquals"/>
  <Style x:Key="CompactNav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#AAB5CC"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="1,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tab" Background="#1B2233" CornerRadius="5" Padding="3,7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="#6546BB"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Badge" TargetType="Ellipse"><Setter Property="Width" Value="5"/><Setter Property="Height" Value="5"/><Setter Property="Fill" Value="#FFBD70"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,-3,-3,0"/></Style>
  <DataTemplate x:Key="MiningBody"><StackPanel Margin="2,9,2,3">
   <TextBlock Text="{Binding MiningStatus}" Foreground="{Binding MiningColor}" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding MiningCountdown}" FontFamily="Consolas" FontSize="36" Foreground="{Binding MiningColor}" Margin="0,1"/>
   <ProgressBar Value="{Binding MiningProgress, Mode=OneWay}" Maximum="100" Foreground="{Binding MiningColor}" Height="5" Margin="0,5"/>
   <TextBlock Text="{Binding MiningNext}" FontSize="11" Foreground="#9AA6BF" TextWrapping="Wrap" Margin="0,4"/>
   <Button Content="Entrei na mina" Command="{Binding StartMiningCommand}" Visibility="{Binding MiningAvailable, Converter={StaticResource BoolVisibility}}" Padding="8,5" FontSize="11" Margin="0,4,0,0"/>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="MvpsBody"><StackPanel Margin="0,7,0,2">
   <ScrollViewer x:Name="MvpScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding CompactMvpViewport}">
    <ItemsControl ItemsSource="{Binding CompactAllRows}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border BorderBrush="#30384B" BorderThickness="0,0,0,1" Padding="0,5" MinHeight="48"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{Binding StatusColor}"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding CompactCountdown}" FontFamily="Consolas" FontSize="18" Foreground="{Binding StatusColor}"/><Button Content="Morreu" ToolTip="Registrar morte agora" Command="{Binding DataContext.KillCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" FontSize="10" Padding="5,4" Margin="5,0,0,0"/></StackPanel>
     </Grid></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <TextBlock Text="Nenhum MVP monitorado" Visibility="{Binding NoMonitoredMvps, Converter={StaticResource BoolVisibility}}" FontSize="11" Foreground="#9AA6BF" Margin="0,10"/>
   <Expander Header="Registrar favorito" FontSize="11" Margin="0,4" Visibility="{Binding Catalog.HasFavorites, Converter={StaticResource BoolVisibility}}"><StackPanel DataContext="{Binding Catalog}"><ComboBox ItemsSource="{Binding FavoriteEntries}" SelectedItem="{Binding SelectedFavorite}" DisplayMemberPath="Summary" Margin="0,4"/><Button Content="Morreu agora" Command="{Binding FavoriteDeathCommand}" Padding="8,4" FontSize="11" Margin="0"/></StackPanel></Expander>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="EventsBody"><StackPanel DataContext="{Binding Events}" Margin="2,8,2,2">
   <StackPanel DataContext="{Binding NextDudu}"><TextBlock Text="👻 Fantasminhas Dudu" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Timing, TargetNullValue=Evento desativado, FallbackValue=Evento desativado}" FontSize="10" Foreground="#9AA6BF"/><TextBlock Text="{Binding Countdown, TargetNullValue=—, FallbackValue=—}" FontFamily="Consolas" FontSize="23" Foreground="#71C8F4"/></StackPanel>
   <Border BorderBrush="#30384B" BorderThickness="0,1,0,0" Margin="0,5"/>
   <StackPanel DataContext="{Binding NextKvm}"><TextBlock Text="⚔ Batalha de Midgard" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Timing, TargetNullValue=Evento desativado, FallbackValue=Evento desativado}" FontSize="10" Foreground="#9AA6BF"/><TextBlock Text="{Binding Countdown, TargetNullValue=—, FallbackValue=—}" FontFamily="Consolas" FontSize="23" Foreground="#71C8F4"/></StackPanel>
   <TextBlock Text="{Binding ZoneLabel}" FontSize="9" Foreground="#9AA6BF" Margin="0,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding ZoneLabel}"/>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="SpotlightBody"><StackPanel DataContext="{Binding Spotlight}" Margin="2,8,2,2">
   <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="Próxima rotação" Foreground="#9AA6BF" FontSize="10" Margin="0,5,0,0"/><TextBlock Text="{Binding Countdown}" FontFamily="Consolas" FontSize="28" Foreground="#BEA7FF"/>
   <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#FFBD70" TextWrapping="Wrap" Margin="0,3"/>
   <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" Margin="0,4,0,3" FontSize="11"/>
   <Button Content="Confirmar grupo" Command="{Binding ConfirmCommand}" Padding="5,4" FontSize="11" Margin="0"/>
  </StackPanel></DataTemplate>
 </UserControl.Resources>
 <Border CornerRadius="12" Background="#121725" BorderBrush="#594880" BorderThickness="1" Padding="9"><DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <Grid MouseLeftButtonDown="DragHeader" Background="Transparent" Height="23" Margin="0,0,0,5"><Image Source="/Assets/AppIcon.ico" Width="12" Height="12" HorizontalAlignment="Left"/><TextBlock Text="FARMLAND" Margin="17,0,0,0" Foreground="#A89BEF" FontWeight="SemiBold" FontSize="10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{Binding PinLabel}" ToolTip="Sempre no topo" Command="{Binding PinCommand}" FontSize="10" Padding="5,2" Margin="0,0,5,0"/><Button Content="—" Click="Minimize" ToolTip="Minimizar" Padding="5,2" Margin="0,0,5,0"/><Button Content="×" Click="CloseAppWindow" ToolTip="Fechar" Padding="5,2" Margin="0"/></StackPanel></Grid>
   <UniformGrid x:Name="TabBar" Columns="4">
    <RadioButton Style="{StaticResource CompactNav}" GroupName="CompactTabs" IsChecked="{Binding ActiveCompactTab, Mode=OneWay, Converter={StaticResource CompactTabEquals}, ConverterParameter=Mining}" Command="{Binding SelectCompactTabCommand}" CommandParameter="Mining" ToolTip="Mina"><Grid><TextBlock Text="⛏ Mina"/><Ellipse Style="{StaticResource Badge}" Visibility="{Binding MiningAttention, Converter={StaticResource BoolVisibility}}"/></Grid></RadioButton>
    <RadioButton Style="{StaticResource CompactNav}" GroupName="CompactTabs" IsChecked="{Binding ActiveCompactTab, Mode=OneWay, Converter={StaticResource CompactTabEquals}, ConverterParameter=Mvps}" Command="{Binding SelectCompactTabCommand}" CommandParameter="Mvps" ToolTip="MVPs"><Grid><TextBlock Text="☠ MVPs"/><Ellipse Style="{StaticResource Badge}" Visibility="{Binding MvpAttention, Converter={StaticResource BoolVisibility}}"/></Grid></RadioButton>
    <RadioButton Style="{StaticResource CompactNav}" GroupName="CompactTabs" IsChecked="{Binding ActiveCompactTab, Mode=OneWay, Converter={StaticResource CompactTabEquals}, ConverterParameter=Events}" Command="{Binding SelectCompactTabCommand}" CommandParameter="Events" ToolTip="Eventos"><Grid><TextBlock Text="🔔 Eventos"/><Ellipse Style="{StaticResource Badge}" Visibility="{Binding EventAttention, Converter={StaticResource BoolVisibility}}"/></Grid></RadioButton>
    <RadioButton Style="{StaticResource CompactNav}" GroupName="CompactTabs" IsChecked="{Binding ActiveCompactTab, Mode=OneWay, Converter={StaticResource CompactTabEquals}, ConverterParameter=Spotlight}" Command="{Binding SelectCompactTabCommand}" CommandParameter="Spotlight" ToolTip="SpotLight"><Grid><TextBlock Text="☀ Spot"/><Ellipse Style="{StaticResource Badge}" Visibility="{Binding SpotlightAttention, Converter={StaticResource BoolVisibility}}"/></Grid></RadioButton>
   </UniformGrid>
  </StackPanel>
  <Button DockPanel.Dock="Bottom" Content="Expandir ↗" Command="{Binding PanelCommand}" HorizontalAlignment="Left" Padding="9,4" FontSize="11" Margin="0,5,0,0"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="600">
   <ContentControl Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource MiningBody}"/><Style.Triggers><DataTrigger Binding="{Binding ActiveCompactTab}" Value="{x:Static models:CompactTab.Mvps}"><Setter Property="ContentTemplate" Value="{StaticResource MvpsBody}"/></DataTrigger><DataTrigger Binding="{Binding ActiveCompactTab}" Value="{x:Static models:CompactTab.Events}"><Setter Property="ContentTemplate" Value="{StaticResource EventsBody}"/></DataTrigger><DataTrigger Binding="{Binding ActiveCompactTab}" Value="{x:Static models:CompactTab.Spotlight}"><Setter Property="ContentTemplate" Value="{StaticResource SpotlightBody}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
  </ScrollViewer>
 </DockPanel></Border>
</UserControl>
