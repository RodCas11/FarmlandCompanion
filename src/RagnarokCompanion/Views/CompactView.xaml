<UserControl x:Class="RagnarokCompanion.Views.CompactView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border CornerRadius="12" Background="#121725" BorderBrush="#594880" BorderThickness="1" Padding="10"><StackPanel>
  <Grid MouseLeftButtonDown="DragHeader" Background="Transparent" Margin="0,0,0,6"><TextBlock Text="FARMLAND" Foreground="#A89BEF" FontWeight="SemiBold" FontSize="10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{Binding PinLabel}" ToolTip="Sempre no topo" Command="{Binding PinCommand}" FontSize="10" Padding="5,2" Margin="0,0,5,0"/><Button Content="—" Click="Minimize" ToolTip="Minimizar" Padding="5,2" Margin="0,0,5,0"/><Button Content="×" Click="CloseAppWindow" ToolTip="Fechar" Padding="5,2" Margin="0"/></StackPanel></Grid>
  <StackPanel Visibility="{Binding ShowMining, Converter={StaticResource BoolVisibility}}" Margin="0,2,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MiningStatus}" Foreground="{Binding MiningColor}"/><TextBlock Grid.Column="1" Text="{Binding MiningCountdown}" FontSize="21" FontFamily="Consolas" Foreground="{Binding MiningColor}"/></Grid><Button Content="Entrei na mina" Command="{Binding StartMiningCommand}" Visibility="{Binding MiningAvailable, Converter={StaticResource BoolVisibility}}" Padding="8,4" FontSize="11" Margin="0,5,0,0"/></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="360"><StackPanel>
   <ItemsControl ItemsSource="{Binding CompactRows}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#30384B" BorderThickness="0,1,0,0" Padding="0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{Binding StatusColor}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding CompactCountdown}" FontFamily="Consolas" FontSize="19" Foreground="{Binding StatusColor}"/><Button Content="Morreu" ToolTip="Registrar morte agora" Command="{Binding DataContext.KillCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" FontSize="10" Padding="5,3" Margin="7,0,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="{Binding CompactEmpty}" Visibility="{Binding NoCompactMvps, Converter={StaticResource BoolVisibility}}" FontSize="11" Foreground="#9AA6BF"/>
  </StackPanel></ScrollViewer>
  <StackPanel DataContext="{Binding Spotlight}" Visibility="{Binding ShowCompact, Converter={StaticResource BoolVisibility}}" Margin="0,6">
   <TextBlock Text="{Binding Summary}" FontSize="11"/><TextBlock Text="{Binding Countdown, StringFormat=Rotação em {0}}" FontFamily="Consolas"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="#FFBD70"/>
   <Expander Header="Alterar Spotlight" FontSize="11"><StackPanel><ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name"/><Button Content="Confirmar grupo" Command="{Binding ConfirmCommand}" Padding="5,3"/></StackPanel></Expander>
  </StackPanel>
  <Expander Header="Registrar favorito" FontSize="11" Margin="0,4" Visibility="{Binding Catalog.HasFavorites, Converter={StaticResource BoolVisibility}}"><StackPanel DataContext="{Binding Catalog}"><ComboBox ItemsSource="{Binding FavoriteEntries}" SelectedItem="{Binding SelectedFavorite}" DisplayMemberPath="Summary" Margin="0,4"/><Button Content="Morreu agora" Command="{Binding FavoriteDeathCommand}" Padding="8,4" FontSize="11" Margin="0"/></StackPanel></Expander>
  <Grid Margin="0,6,0,0"><Button Content="Expandir ↗" Command="{Binding PanelCommand}" HorizontalAlignment="Left" Padding="9,5" FontSize="11" Margin="0"/><Button Content="{Binding ExpandLabel}" Command="{Binding ExpandCommand}" HorizontalAlignment="Right" Padding="9,5" FontSize="11" Margin="0"/></Grid>
 </StackPanel></Border>
</UserControl>
