<UserControl x:Class="RagnarokCompanion.Views.CompactView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:RagnarokCompanion.ViewModels" xmlns:models="clr-namespace:RagnarokCompanion.Models" xmlns:views="clr-namespace:RagnarokCompanion.Views">
 <UserControl.Resources>
  <vm:CompactTabConverter x:Key="CompactTabEquals"/>
  <Style x:Key="CompactNav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#AAB5CC"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="1,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tab" Background="#1B2233" CornerRadius="5" Padding="3,5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="#3B301E"/><Setter Property="Foreground" Value="#E9C77A"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Badge" TargetType="Ellipse"><Setter Property="Width" Value="5"/><Setter Property="Height" Value="5"/><Setter Property="Fill" Value="#FFBD70"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,-3,-3,0"/></Style>
  <DataTemplate x:Key="MiningBody"><StackPanel Margin="2,9,2,3">
   <TextBlock Text="{Binding MiningStatus}" Foreground="{Binding MiningColor}" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding MiningCountdown}" FontFamily="Consolas" FontSize="36" Foreground="{Binding MiningColor}" Margin="0,1"/>
   <ProgressBar Value="{Binding MiningProgress, Mode=OneWay}" Maximum="100" Foreground="{Binding MiningColor}" Height="5" Margin="0,5"/>
   <TextBlock Text="{Binding MiningNext}" FontSize="11" Foreground="#9AA6BF" TextWrapping="Wrap" Margin="0,4"/>
   <Button Content="Entrei na mina" Command="{Binding StartMiningCommand}" Visibility="{Binding MiningAvailable, Converter={StaticResource BoolVisibility}}" Padding="8,5" FontSize="11" Margin="0,4,0,0"/>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="MvpsBody"><StackPanel DataContext="{Binding Catalog}" Margin="0,7,0,2">
   <ItemsControl ItemsSource="{Binding CompactFavorites}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#30384B" BorderThickness="0,0,0,1" Padding="1,6" MinHeight="48"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{Binding Color}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Countdown}" FontSize="{Binding ClockFont}" ToolTip="{Binding TimeTooltip}" FontFamily="Consolas" Foreground="{Binding Color}" Margin="8,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="Favorite MVPs no painel para acompanhar aqui." TextWrapping="Wrap" Visibility="{Binding NoCompactFavorites, Converter={StaticResource BoolVisibility}}" Foreground="#9AA6BF" FontSize="11" Margin="2,12"/>
   <CheckBox Content="Mostrar horário previsto" IsChecked="{Binding ShowAbsoluteTimes}" FontSize="10" Margin="2,5"/><Button Content="Limpar MVPs" Command="{Binding ClearTimersCommand}" HorizontalAlignment="Left" Padding="5,4" Background="Transparent" Foreground="#9AA6BF" FontSize="10" Margin="0,6,0,0"/>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="EventsBody"><StackPanel DataContext="{Binding Events}" Margin="2,0">
   <ItemsControl ItemsSource="{Binding CompactUpcoming}"><ItemsControl.ItemTemplate><DataTemplate>
    <Border BorderBrush="#30384B" BorderThickness="0,0,0,1" Padding="0,4" Height="48"><StackPanel DataContext="{Binding Occurrence}"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timing}" FontSize="10" Foreground="#9AA6BF"/><TextBlock Grid.Column="1" Text="{Binding Countdown}" FontFamily="Consolas" FontSize="20" Foreground="#71C8F4"/></Grid></StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="Nenhum evento programado" Visibility="{Binding NoToday, Converter={StaticResource BoolVisibility}}" FontSize="11" Foreground="#9AA6BF"/>
   <TextBlock Text="{Binding ZoneLabel}" FontSize="9" Foreground="#9AA6BF" Margin="0,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding ZoneLabel}"/>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="ItemsBody"><StackPanel DataContext="{Binding Items}" Margin="2,8">
   <TextBlock Text="Buscar item pelo nome ou ID..." FontSize="10" Foreground="#9AA6BF"/>
   <DockPanel><Button DockPanel.Dock="Right" Content="Ir" Command="{Binding SearchCommand}" Padding="6,4"/><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="11"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox></DockPanel>
   <ComboBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="Label" FontSize="11" Margin="0,3"/>
   <DockPanel views:ItemTooltip.Model="{Binding}" Tag="ItemTooltipHost" Background="Transparent" Margin="0,5"><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,6,0" DockPanel.Dock="Left"/><TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12"/></DockPanel>
   <StackPanel DataContext="{Binding Best}"><TextBlock Text="{Binding MonsterName}" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{Binding ChanceLabel}" Foreground="#6CD9A5" FontSize="20"/><TextBlock Text="{Binding MapLabel}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Population}" FontSize="10" Foreground="#9AA6BF"/><TextBlock Text="{Binding MapSource}" FontSize="9" Foreground="#9AA6BF" TextWrapping="Wrap"/></StackPanel>
   <TextBlock Text="Drops Farmland" FontSize="9" Foreground="#9AA6BF" Margin="0,4"/>
   <TextBlock Text="{Binding Status}" FontSize="10" TextWrapping="Wrap" Foreground="#9AA6BF"/>
   <Button Content="Ver mapa" Command="{Binding MapCommand}" CommandParameter="{Binding Best}" Visibility="{Binding Best.HasMap, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" FontSize="10" Padding="6,3"/>
   <Button Content="Mostrar chances menores" Command="{Binding LowerCommand}" Visibility="{Binding OfferLower, Converter={StaticResource BoolVisibility}}" FontSize="10" Padding="6,3"/>
   <Button Content="Ver no Divine Pride ↗" Command="{Binding OpenItemCommand}" IsEnabled="{Binding HasItem}" HorizontalAlignment="Left" Background="Transparent" Foreground="#9AA6BF" BorderThickness="0" Padding="0,4" FontSize="10"/>
   <Expander Header="Outras opções"><ItemsControl ItemsSource="{Binding Others}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4"><TextBlock Text="{Binding MonsterName}" FontSize="11"/><TextBlock Text="{Binding ChanceLabel}" Foreground="#6CD9A5" FontSize="11"/><TextBlock Text="{Binding MapLabel}" TextWrapping="Wrap" FontSize="10"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
  </StackPanel></DataTemplate>
  <DataTemplate x:Key="QuestsBody"><StackPanel DataContext="{Binding Quests}" Margin="2,8">
  <TextBlock Text="Quests favoritas" Foreground="#E9C77A" FontWeight="SemiBold"/>
  <ComboBox ItemsSource="{Binding Favorites}" SelectedItem="{Binding CompactSelected}" DisplayMemberPath="Name" Margin="0,7"/>
  <TextBlock Text="Favorite uma quest no painel completo para acompanhar aqui." Foreground="#9AA6BF" TextWrapping="Wrap" FontSize="10"/>
  <views:QuestDetailsView Visibility="{Binding Selected.Favorite, Converter={StaticResource BoolVisibility}, FallbackValue=Collapsed}"/>
 </StackPanel></DataTemplate>
 </UserControl.Resources>
 <Border CornerRadius="12" Background="#121725" BorderBrush="#665332" BorderThickness="1" Padding="9"><DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <Grid MouseLeftButtonDown="DragHeader" Background="Transparent" Height="24" Margin="0,0,0,6"><Image Source="/Assets/FarmlandMark.png" Width="34" Height="23" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Farmland Companion"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button ToolTip="{Binding PinLabel}" AutomationProperties.Name="Sempre no topo" Command="{Binding PinCommand}" Width="24" Height="22" Padding="4" Margin="0,0,4,0"><TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#9AA6BF"/><Style.Triggers><DataTrigger Binding="{Binding Settings.Topmost}" Value="True"><Setter Property="Foreground" Value="#E9C77A"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button><Button Content="—" Click="Minimize" ToolTip="Minimizar" Width="24" Height="22" Padding="3" Margin="0,0,4,0"/><Button Content="×" Click="CloseAppWindow" ToolTip="Fechar" Width="24" Height="22" Padding="3" Margin="0"/></StackPanel></Grid>
   <UniformGrid x:Name="TabBar" Columns="5">
    <RadioButton Style="{StaticResource CompactNav}" GroupName="CompactTabs" IsChecked="{Binding ActiveCompactTab, Mode=OneWay, Converter={StaticResource CompactTabEquals}, ConverterParameter=Mining}" Command="{Binding SelectCompactTabCommand}" CommandParameter="Mining" ToolTip="Mina" AutomationProperties.Name="Mina"><Grid><TextBlock Text="⛏" FontFamily="Segoe UI Symbol" FontSize="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><Ellipse Style="{StaticResource Badge}" Visibility="{Binding MiningAttention, Converter={StaticResource BoolVisibility}}"/></Grid></RadioButton>
    <RadioButton Style="{StaticResource CompactNav}" GroupName="CompactTabs" IsChecked="{Binding ActiveCompactTab, Mode=OneWay, Converter={StaticResource CompactTabEquals}, ConverterParameter=Mvps}" Command="{Binding SelectCompactTabCommand}" CommandParameter="Mvps" ToolTip="MVPs" AutomationProperties.Name="MVPs"><Grid><TextBlock Text="☠" FontFamily="Segoe UI Symbol" FontSize="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><Ellipse Style="{StaticResource Badge}" Visibility="{Binding MvpAttention, Converter={StaticResource BoolVisibility}}"/></Grid></RadioButton>
    <RadioButton Style="{StaticResource CompactNav}" GroupName="CompactTabs" IsChecked="{Binding ActiveCompactTab, Mode=OneWay, Converter={StaticResource CompactTabEquals}, ConverterParameter=Events}" Command="{Binding SelectCompactTabCommand}" CommandParameter="Events" ToolTip="Eventos" AutomationProperties.Name="Eventos"><Grid><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M 5,17 L 7,14 L 7,9 C 7,2 17,2 17,9 L 17,14 L 19,17 Z M 10,20 C 10,23 14,23 14,20" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox><Ellipse Style="{StaticResource Badge}" Visibility="{Binding EventAttention, Converter={StaticResource BoolVisibility}}"/></Grid></RadioButton>
    <RadioButton Style="{StaticResource CompactNav}" GroupName="CompactTabs" IsChecked="{Binding ActiveCompactTab, Mode=OneWay, Converter={StaticResource CompactTabEquals}, ConverterParameter=Items}" Command="{Binding SelectCompactTabCommand}" CommandParameter="Items" ToolTip="Itens" AutomationProperties.Name="Itens"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></RadioButton>
   <RadioButton Style="{StaticResource CompactNav}" GroupName="CompactTabs" IsChecked="{Binding ActiveCompactTab, Mode=OneWay, Converter={StaticResource CompactTabEquals}, ConverterParameter=Quests}" Command="{Binding SelectCompactTabCommand}" CommandParameter="Quests" ToolTip="Quests" AutomationProperties.Name="Quests"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></RadioButton></UniformGrid>
  </StackPanel>
  <Button DockPanel.Dock="Bottom" Content="Expandir ↗" Command="{Binding PanelCommand}" HorizontalAlignment="Left" Padding="9,4" FontSize="11" Margin="0,5,0,0"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="600"/><Style.Triggers><DataTrigger Binding="{Binding ActiveCompactTab}" Value="{x:Static models:CompactTab.Events}"><Setter Property="MaxHeight" Value="144"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
   <ContentControl Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource MiningBody}"/><Style.Triggers><DataTrigger Binding="{Binding ActiveCompactTab}" Value="{x:Static models:CompactTab.Mvps}"><Setter Property="ContentTemplate" Value="{StaticResource MvpsBody}"/></DataTrigger><DataTrigger Binding="{Binding ActiveCompactTab}" Value="{x:Static models:CompactTab.Events}"><Setter Property="ContentTemplate" Value="{StaticResource EventsBody}"/></DataTrigger><DataTrigger Binding="{Binding ActiveCompactTab}" Value="{x:Static models:CompactTab.Items}"><Setter Property="ContentTemplate" Value="{StaticResource ItemsBody}"/></DataTrigger><DataTrigger Binding="{Binding ActiveCompactTab}" Value="{x:Static models:CompactTab.Quests}"><Setter Property="ContentTemplate" Value="{StaticResource QuestsBody}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
  </ScrollViewer>
 </DockPanel></Border>
</UserControl>
