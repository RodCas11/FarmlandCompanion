<UserControl x:Class="RagnarokCompanion.Views.DivinePrideSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Divine Pride" FontSize="20"/><TextBlock Text="Busca local; detalhes por ID e cache offline." Style="{StaticResource Muted}"/><TextBlock Text="API Key Divine Pride"/><PasswordBox x:Name="KeyInput" MaxLength="4096" Padding="10,8" Margin="0,6" Background="#0F1422" Foreground="#EDF0FA" BorderBrush="#354057"/><WrapPanel><Button Content="Proteger e salvar chave" Click="SaveKey"/><Button Content="Apagar chave" Command="{Binding DeleteKeyCommand}"/></WrapPanel><TextBlock Text="{Binding KeyStatus}" Style="{StaticResource Muted}"/><TextBlock Text="Região"/><ComboBox ItemsSource="{Binding Gateways}" SelectedValue="{Binding GatewaySlug}" SelectedValuePath="Slug" DisplayMemberPath="Label"/><TextBlock Text="Idioma"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"/><Button Content="Testar conexão" Command="{Binding TestConnectionCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding AuthStatus}" TextWrapping="Wrap"/><TextBlock Text="{Binding LastSync}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock><Hyperlink NavigateUri="https://www.divine-pride.net/tools/api-doc" RequestNavigate="OpenAttribution">Obter chave no perfil Divine Pride ↗</Hyperlink></TextBlock></StackPanel></Border>
</UserControl>