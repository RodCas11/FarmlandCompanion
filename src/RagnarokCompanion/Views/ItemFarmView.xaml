<UserControl x:Class="RagnarokCompanion.Views.ItemFarmView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RagnarokCompanion.Views">
 <UserControl.Resources>
  <DataTemplate x:Key="FarmCard"><Border Style="{StaticResource Card}" Margin="0,5"><StackPanel>
   <TextBlock Text="{Binding Heading}" Foreground="#A89BEF" FontSize="11"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ChanceLabel}" Foreground="#6CD9A5" FontSize="21"/><TextBlock Text="{Binding MonsterName}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/></DockPanel>
   <TextBlock Text="{Binding MapLabel}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Text="{Binding Population}" Foreground="#9AA6BF"/><TextBlock Text="{Binding MapSource}" Foreground="#9AA6BF" FontSize="10" TextWrapping="Wrap" Margin="0,3"/>
   <Button Content="Ver mapa" HorizontalAlignment="Left" Visibility="{Binding HasMap, Converter={StaticResource BoolVisibility}}" Command="{Binding DataContext.MapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,4"/>
   <Expander Header="Detalhes" Margin="0,4"><StackPanel><TextBlock Text="{Binding ScoreLabel}" TextWrapping="Wrap"/><TextBlock Text="{Binding SourceLabel}" Foreground="#9AA6BF" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Evidence}" FontSize="10" Foreground="#9AA6BF" TextWrapping="Wrap" Margin="0,5"/>
    <ItemsControl ItemsSource="{Binding Monster.Spawns}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" FontSize="11"><Run Text="{Binding Name}"/><Run Text=" · "/><Run Text="{Binding Map}"/><Run Text=" · população "/><Run Text="{Binding Count, TargetNullValue=desconhecida}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="Consultar monstro no Divine Pride" Command="{Binding DataContext.MonsterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Padding="8,4"/>
   </StackPanel></Expander>
  </StackPanel></Border></DataTemplate>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="Buscar Itens" Style="{StaticResource Title}"/><TextBlock Text="Pesquise um item e encontre monstros comuns com os drops do Farmland." Style="{StaticResource Muted}"/>
  <TextBlock Text="Buscar item pelo nome ou ID..." Margin="0,18,0,3"/><DockPanel><Button DockPanel.Dock="Right" Content="Pesquisar" Command="{Binding SearchCommand}" Style="{StaticResource Primary}"/><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome ou ID do item no banco local" VerticalContentAlignment="Center"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox></DockPanel>
  <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedItem}" DisplayMemberPath="Label" MaxHeight="135"/>
  <WrapPanel Margin="0,10"><StackPanel Margin="0,0,18,0"><TextBlock Text="Chance mínima de drop" FontSize="11"/><ComboBox ItemsSource="{Binding MinimumOptions}" SelectedItem="{Binding Minimum}" Width="150"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding StringFormat={}{0}% ou mais}"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="0"><Setter Property="Text" Value="Todas"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
   <StackPanel Margin="0,0,18,0"><TextBlock Text="Ordenar por" FontSize="11"/><ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" Width="155"/></StackPanel><CheckBox Content="Somente monstros comuns" IsChecked="{Binding FarmableOnly}" VerticalAlignment="Center"/>
  </WrapPanel>
  <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#9AA6BF" Margin="0,5"/>
  <Button Content="Mostrar chances menores" Command="{Binding LowerCommand}" Visibility="{Binding OfferLower, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left"/>
  <Border Style="{StaticResource Card}" Margin="0,10"><StackPanel><DockPanel views:ItemTooltip.Model="{Binding}" Tag="ItemTooltipHost" Background="Transparent"><Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0" DockPanel.Dock="Left"/><TextBlock Text="{Binding ItemName}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><Button Content="Ver no Divine Pride ↗" Command="{Binding OpenItemCommand}" IsEnabled="{Binding HasItem}" HorizontalAlignment="Left" Background="Transparent" Foreground="#9AA6BF" BorderThickness="0" Padding="0,5" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border>
  <TextBlock Text="Melhores monstros para farmar" Foreground="#A89BEF" FontSize="18" Margin="0,8" Visibility="{Binding HasBest, Converter={StaticResource BoolVisibility}}"/>
  <ContentControl Content="{Binding Best}" ContentTemplate="{StaticResource FarmCard}" Visibility="{Binding HasBest, Converter={StaticResource BoolVisibility}}"/>
  <ItemsControl ItemsSource="{Binding Others}" ItemTemplate="{StaticResource FarmCard}"/>
  <Expander Header="Variantes especiais — excluídas por padrão" Margin="0,8"><ItemsControl ItemsSource="{Binding Excluded}" ItemTemplate="{StaticResource FarmCard}"/></Expander>
  <TextBlock Text="Chance × população é um indicador comparativo, não itens por hora. População não é velocidade de respawn. Sem arquivos de spawn do Farmland, o mapa e a população permanecem desconhecidos." Foreground="#9AA6BF" FontSize="11" TextWrapping="Wrap" Margin="0,12"/>
 </StackPanel></ScrollViewer>
</UserControl>
