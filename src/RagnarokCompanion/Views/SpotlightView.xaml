<UserControl x:Class="RagnarokCompanion.Views.SpotlightView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SpotlightStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="SpotLight" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <Border Background="#181E2D" CornerRadius="9" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="GRUPO EM CONSULTA" FontSize="10" Foreground="#9AA6BF"/><ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Name" Margin="0,5,18,3"/><WrapPanel><TextBlock Text="{Binding Count}" FontSize="12" Foreground="#BDA9FF" Margin="0,0,16,0"/><TextBlock Text="{Binding Countdown, StringFormat=Próxima rotação em {0}}" FontFamily="Consolas" FontSize="12"/></WrapPanel></StackPanel>
    <StackPanel Grid.Column="1" MaxWidth="300" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="#FFBD70" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="Consultar um grupo não confirma o ativo." FontSize="10" Foreground="#9AA6BF" Margin="0,4"/><Button Content="Corrigir SpotLight atual" Command="{Binding ConfirmCommand}" Padding="10,7" Margin="0,3,0,0" FontSize="11"/></StackPanel>
   </Grid></Border><Expander Header="Configurar rotação automática · 20h de São Paulo" Margin="0,7"><StackPanel><TextBlock Text="{Binding RotationHelp}" Foreground="#9AA6BF" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="Informe a sequência completa confirmada pelo servidor, separada por →." Foreground="#9AA6BF" FontSize="11" Margin="0,4"/><TextBox Text="{Binding RotationDraft, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Salvar sequência" Command="{Binding SaveRotationCommand}" HorizontalAlignment="Left"/></StackPanel></Expander>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Buscar mapa ou código" FontSize="11" Foreground="#9AA6BF"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,10,0" ToolTip="Pesquise pelo nome ou pelo código do mapa."/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="Recomendado" FontSize="11" Foreground="#9AA6BF"/><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" DisplayMemberPath="Label" Margin="0,4,10,0"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="Seu nível (opcional)" FontSize="11" Foreground="#9AA6BF"/><TextBox Text="{Binding CharacterLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,10,0" ToolTip="Destaca os mapas que incluem seu nível na faixa publicada."/></StackPanel>
   <Button Grid.Column="3" Content="Limpar filtros" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" Margin="0" Padding="10,9" FontSize="11"/>
  </Grid>
  <DataGrid x:Name="MapsGrid" Grid.Row="2" ItemsSource="{Binding Maps}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" Background="#141A28" Foreground="#EDF0FA" BorderBrush="#30384B" BorderThickness="1" RowHeight="39" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#252D3E" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel" EnableRowVirtualization="True">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Código" Binding="{Binding Map.Code}" SortMemberPath="Map.Code" Width="112"/>
    <DataGridTextColumn Header="Mapa" Binding="{Binding Map.Name}" SortMemberPath="Map.Name" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
    <DataGridTextColumn Header="Mín." Binding="{Binding Map.MinLevel, TargetNullValue=—}" SortMemberPath="Map.MinLevel" Width="52"/>
    <DataGridTextColumn Header="Máx." Binding="{Binding Map.MaxLevel, TargetNullValue=—}" SortMemberPath="Map.MaxLevel" Width="52"/>
    <DataGridTextColumn Header="Recom." Binding="{Binding Map.Recommended, TargetNullValue=—}" ElementStyle="{StaticResource RecommendedLevel}" SortMemberPath="Map.Recommended" Width="68"/>
    <DataGridTemplateColumn Header="Mapa" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Ver mapa ↗" ToolTip="Abrir a página deste mapa no navegador. Indisponível quando a fonte não informa um link." IsEnabled="{Binding Map.HasMapLink}" Command="{Binding DataContext.OpenMapCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Map}" Padding="7,5" Margin="0" FontSize="11"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <Grid Grid.Row="3" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Message}" Foreground="#9AA6BF" FontSize="10" TextWrapping="Wrap"/><Expander Header="Fonte e confirmação" FontSize="10"><StackPanel><TextBlock Text="{Binding Source}" Foreground="#9AA6BF" TextWrapping="Wrap"/><TextBlock Text="{Binding Confirmation}" Foreground="#9AA6BF"/><TextBlock><Hyperlink NavigateUri="https://farmland.net.br/wiki/index.php/SpotLight" RequestNavigate="OpenSource">Wiki Farmland ↗</Hyperlink></TextBlock></StackPanel></Expander></StackPanel><Button Grid.Column="1" Content="Atualizar detalhes da wiki" Command="{Binding RefreshCommand}" FontSize="10" Padding="8,6" VerticalAlignment="Top" Margin="10,0,0,0"/></Grid>
 </Grid>
</UserControl>
