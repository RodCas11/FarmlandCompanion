<UserControl x:Class="RagnarokCompanion.Views.SpotlightView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel>
 <StackPanel DockPanel.Dock="Top">
  <TextBlock Text="SpotLight" Style="{StaticResource Title}"/>
  <TextBlock Text="Informe o grupo atual do servidor. Rotação às 20h de São Paulo." TextWrapping="Wrap" Style="{StaticResource Muted}"/>
  <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Summary" Margin="0,12,0,6"/>
  <WrapPanel><TextBlock Text="{Binding Status}" Foreground="#FFBD70" VerticalAlignment="Center"/><Button Content="Confirmar grupo" Command="{Binding ConfirmCommand}" Margin="12,4,0,4"/></WrapPanel>
  <TextBlock Text="{Binding Confirmation}" Style="{StaticResource Muted}"/>
  <TextBlock Text="{Binding Countdown, StringFormat=Próxima rotação em {0}}" FontFamily="Consolas" Margin="0,6"/>
  <WrapPanel Margin="0,8"><StackPanel Width="240" Margin="0,0,12,0"><TextBlock Text="Buscar mapa ou código"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="130" Margin="0,0,12,0"><TextBlock Text="Recomendado"/><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" DisplayMemberPath="Label"/></StackPanel><StackPanel Width="130"><TextBlock Text="Seu nível (opcional)"/><TextBox Text="{Binding CharacterLevel, UpdateSourceTrigger=PropertyChanged}" ToolTip="Destaca mapas cuja faixa inclui seu nível."/></StackPanel></WrapPanel>
  <TextBlock Text="{Binding Count}" Margin="0,4,0,10"/>
 </StackPanel>
 <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><WrapPanel><Button Content="Atualizar catálogo" Command="{Binding RefreshCommand}"/><TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel><TextBlock Text="{Binding Source}" FontSize="10" Foreground="#9AA6BF"/><TextBlock FontSize="10"><Hyperlink NavigateUri="https://farmland.net.br/wiki/index.php/SpotLight" RequestNavigate="OpenSource">Fonte oficial • Wiki Farmland</Hyperlink></TextBlock></StackPanel>
 <DataGrid ItemsSource="{Binding Maps}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="#141928" Foreground="#EDF0FA" RowBackground="#141928" AlternatingRowBackground="#1B2233" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#30384B" BorderThickness="0">
 <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#252D43"/><Setter Property="Foreground" Value="#EDF0FA"/><Setter Property="Padding" Value="8"/></Style></DataGrid.Resources>
 <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Map.MonsterInfo}"/><Style.Triggers><DataTrigger Binding="{Binding Suitable}" Value="True"><Setter Property="Background" Value="#254B42"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
 <DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Map.Code}" SortMemberPath="Map.Code" Width="125"/><DataGridTextColumn Header="Mapa" Binding="{Binding Map.Name}" SortMemberPath="Map.Name" Width="*"/><DataGridTextColumn Header="Mín." Binding="{Binding Map.MinLevel, TargetNullValue=—}" SortMemberPath="Map.MinLevel" Width="55"/><DataGridTextColumn Header="Máx." Binding="{Binding Map.MaxLevel, TargetNullValue=—}" SortMemberPath="Map.MaxLevel" Width="55"/><DataGridTextColumn Header="Recom." Binding="{Binding Map.Recommended, TargetNullValue=—}" SortMemberPath="Map.Recommended" Width="70"/><DataGridTemplateColumn Header="Wiki" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="↗" ToolTip="Abrir no Divine Pride" Command="{Binding DataContext.OpenMapCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Map}" Padding="4,1" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
 </DataGrid>
 </DockPanel>
</UserControl>
