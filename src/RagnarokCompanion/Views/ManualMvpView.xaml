<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RagnarokCompanion.Views" x:Class="RagnarokCompanion.Views.ManualMvpView"><StackPanel><WrapPanel><Button Content="Novo cadastro" Command="{Binding NewMvpCommand}"/><Button Content="Editar selecionado" Command="{Binding EditMvpCommand}"/><Button Content="Excluir selecionado" Command="{Binding DeleteMvpCommand}"/></WrapPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Cadastro / edição" FontSize="20"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Nome"/><TextBox Text="{Binding EditName}"/></StackPanel><StackPanel><TextBlock Text="Mapa"/><TextBox Text="{Binding EditMap}"/></StackPanel><StackPanel><TextBlock Text="Respawn mínimo (min)"/><TextBox Text="{Binding EditMin, ValidatesOnExceptions=True}"/></StackPanel><StackPanel><TextBlock Text="Respawn máximo (min)"/><TextBox Text="{Binding EditMax, ValidatesOnExceptions=True}"/></StackPanel></UniformGrid><TextBlock Text="Observações"/><TextBox Text="{Binding EditNotes}" AcceptsReturn="True" Height="60"/><Button Content="Salvar MVP" Command="{Binding SaveMvpCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Morte antiga / corrigir horário do selecionado" FontSize="18"/><TextBlock Text="Data e hora local • dd/MM/aaaa HH:mm:ss" Style="{StaticResource Muted}"/><TextBox Text="{Binding ManualDeath}"/><Button Content="Registrar horário informado" Command="{Binding CorrectDeathCommand}" HorizontalAlignment="Left"/><TextBlock Text="Última morte do selecionado:" Style="{StaticResource Muted}"/><TextBlock Text="{Binding SelectedMvp.LastDeath}"/><TextBlock Text="{Binding SelectedMvp.Notes}" TextWrapping="Wrap"/></StackPanel></Border>
</StackPanel></UserControl>