<UserControl x:Class="RagnarokCompanion.Views.UpdatesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Atualizações" FontSize="20"/><TextBlock><Run Text="Versão instalada: "/><Run Text="{Binding InstalledVersion, Mode=OneWay}"/></TextBlock><TextBlock><Run Text="Última versão disponível: "/><Run Text="{Binding AvailableVersion, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/><WrapPanel><Button Content="Verificar atualizações" Command="{Binding CheckCommand}"/><Button Content="Atualizar agora" Command="{Binding InstallCommand}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}" Style="{StaticResource Primary}"/></WrapPanel><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="Verificação ao iniciar e a cada 6 horas. Apenas releases estáveis oficiais." Style="{StaticResource Muted}"/></StackPanel></Border>
</UserControl>
