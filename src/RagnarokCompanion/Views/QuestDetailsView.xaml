<UserControl x:Class="RagnarokCompanion.Views.QuestDetailsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <DockPanel Margin="0,8"><Image DockPanel.Dock="Left" Source="{Binding Selected.Model.Icon}" Width="40" Height="40" Margin="0,0,10,0"/><TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#E9C77A"/></DockPanel>
  <TextBlock Text="{Binding Selected.Model.Cost, StringFormat=Custo: {0}}" Margin="0,4,0,10"/>
  <TextBlock Text="Materiais necessários" FontWeight="SemiBold"/>
  <ItemsControl ItemsSource="{Binding Materials}"><ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="#181E2D" BorderBrush="#30384B" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,5"><StackPanel>
    <CheckBox IsChecked="{Binding Obtained}" Content="{Binding Model.Label}" FontWeight="SemiBold" ToolTip="Marcar material já obtido"/>
    <TextBlock Text="{Binding Model.Amount, StringFormat=Quantidade: {0:N0}}" Margin="0,4" Foreground="#E9C77A"/>
    <TextBlock Text="{Binding Farm}" TextWrapping="Wrap" Foreground="#AAB5CC" FontSize="11"/>
    <Button Content="Ver mapa ↗" Command="{Binding MapCommand}" Visibility="{Binding HasMap, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Padding="6,4" FontSize="11"/>
    <TextBlock Text="{Binding SpotlightLabel}" Foreground="#E9C77A" TextWrapping="Wrap" FontSize="11" Margin="0,5"/>
    <Button Content="Ver mapa no SpotLight ↗" Command="{Binding SpotlightMapCommand}" Visibility="{Binding HasSpotlight, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Padding="6,4" FontSize="11"/>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel>
</UserControl>
