<UserControl x:Class="RagnarokCompanion.Views.QuestDetailsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RagnarokCompanion.Views">
 <StackPanel>
  <DockPanel Margin="0,5" Background="Transparent" views:ItemTooltip.Model="{Binding Selected}"><Image DockPanel.Dock="Left" Source="{Binding Selected.Model.Icon}" Width="36" Height="36" Margin="0,0,8,0"/><TextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#E9C77A"/></DockPanel>
  <TextBlock Text="{Binding Selected.Model.Cost, StringFormat=Custo: {0}}" Margin="0,3,0,8"/>
  <TextBlock Text="Materiais necessários" FontWeight="SemiBold" Margin="0,0,0,3"/>
  <ItemsControl ItemsSource="{Binding Materials}"><ItemsControl.ItemTemplate><DataTemplate>
   <Border BorderBrush="#30384B" BorderThickness="0,0,0,1" Padding="2,6" Margin="0"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Image Grid.Column="0" Source="{Binding Icon}" ImageFailed="MaterialImageFailed" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Left" views:ItemTooltip.Model="{Binding}"/>
    <TextBlock Grid.Column="1" Text="{Binding Model.Label}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Background="Transparent" views:ItemTooltip.Model="{Binding}"/>
    <TextBlock Grid.Column="2" Text="{Binding Quantity}" Foreground="#E9C77A" FontSize="12" Margin="6,0,1,0" VerticalAlignment="Center"/>
    <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,1,0,0"><Button DockPanel.Dock="Right" Content="Ver mapa ↗" Command="{Binding MapCommand}" Visibility="{Binding HasMap, Converter={StaticResource BoolVisibility}}" Padding="4,2" Margin="5,0,0,0" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="{Binding FarmLine}" ToolTip="{Binding Farm}" TextWrapping="Wrap" Foreground="#AAB5CC" FontSize="10" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding MapReference}" ToolTip="{Binding Best.Evidence}" Visibility="{Binding HasReference, Converter={StaticResource BoolVisibility}}" Foreground="#7E8BA4" FontSize="9"/>
    <DockPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Visibility="{Binding HasDependency, Converter={StaticResource BoolVisibility}}" Margin="0,2,0,0"><Button DockPanel.Dock="Right" Content="Ver quest ↗" ToolTip="Ver quest necessária" Command="{Binding DependencyCommand}" Padding="4,2" Margin="5,0,0,0" FontSize="10"/><TextBlock Text="{Binding DependencyLabel}" Foreground="#E9C77A" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    <DockPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Visibility="{Binding HasSpotlight, Converter={StaticResource BoolVisibility}}" Margin="0,2,0,0"><Button DockPanel.Dock="Right" Content="Ver mapa ↗" ToolTip="Ver mapa no SpotLight" Command="{Binding SpotlightMapCommand}" Padding="4,2" Margin="5,0,0,0" FontSize="10"/><TextBlock Text="{Binding SpotlightLabel}" Foreground="#E9C77A" TextWrapping="Wrap" FontSize="10" VerticalAlignment="Center"/></DockPanel>
   </Grid></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel>
</UserControl>
