<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RagnarokCompanion.Views" x:Class="RagnarokCompanion.Views.SettingsView"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Configurações" Style="{StaticResource Title}"/><TextBlock Text="Preferências do aplicativo e conexão com o RagnaPlace." Style="{StaticResource Muted}"/><Border Style="{StaticResource Card}" Margin="0,16,0,8"><StackPanel><CheckBox Content="Sons da mina e dos MVPs" IsChecked="{Binding Settings.Sounds}"/><CheckBox Content="Continuar na bandeja ao fechar" IsChecked="{Binding Settings.CloseToTray}"/><CheckBox Content="Abrir compacto ao iniciar um timer" IsChecked="{Binding Settings.CompactOnTimer}"/></StackPanel></Border><Expander Header="Conexão com o RagnaPlace" Margin="0,12"><views:RagnaPlaceSettingsView DataContext="{Binding Catalog}"/></Expander><Expander Header="Notificações de eventos" Margin="0,12"><Border Style="{StaticResource Card}"><views:EventSettingsView DataContext="{Binding Events}"/></Border></Expander><Expander Header="Preferências avançadas"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ciclos e alertas" FontSize="20"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="Mineração (minutos)"/><TextBox Text="{Binding Settings.MiningMinutes, ValidatesOnExceptions=True}"/></StackPanel><StackPanel><TextBlock Text="Cooldown (minutos)"/><TextBox Text="{Binding Settings.CooldownMinutes, ValidatesOnExceptions=True}"/></StackPanel></UniformGrid><TextBlock Text="Antecedência dos MVPs em minutos, separada por vírgulas"/><TextBox Text="{Binding Settings.AdvanceMinutes}"/><WrapPanel><CheckBox Content="Alertas da mina" IsChecked="{Binding Settings.MiningAlerts}"/><CheckBox Content="Alertas dos MVPs" IsChecked="{Binding Settings.MvpAlerts}"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Janela compacta" FontSize="20"/><TextBlock Text="Exibir" Style="{StaticResource Muted}"/><ComboBox SelectedValue="{Binding Settings.CompactMode}" SelectedValuePath="Content"><ComboBoxItem Content="Ambos"/><ComboBoxItem Content="Mineração"/><ComboBoxItem Content="MVPs"/></ComboBox><TextBlock Text="Quantidade de MVPs"/><ComboBox SelectedValue="{Binding Settings.CompactCount}" SelectedValuePath="Content"><ComboBoxItem><ComboBoxItem.Content><sys:Int32 xmlns:sys="clr-namespace:System;assembly=System.Runtime">1</sys:Int32></ComboBoxItem.Content></ComboBoxItem><ComboBoxItem><ComboBoxItem.Content><sys:Int32 xmlns:sys="clr-namespace:System;assembly=System.Runtime">3</sys:Int32></ComboBoxItem.Content></ComboBoxItem><ComboBoxItem><ComboBoxItem.Content><sys:Int32 xmlns:sys="clr-namespace:System;assembly=System.Runtime">5</sys:Int32></ComboBoxItem.Content></ComboBoxItem></ComboBox>
      <CheckBox Content="Sempre no topo (Topmost do WPF)" IsChecked="{Binding Settings.Topmost}"/>
      <TextBlock Text="Opacidade (50% a 100%)"/><Slider Minimum="0.5" Maximum="1" Value="{Binding Settings.Opacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,10"/>
      <TextBlock Text="Tamanho da fonte (11 a 24)"/><Slider Minimum="11" Maximum="24" Value="{Binding Settings.FontSize}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10"/>
      <CheckBox Content="Abrir compacto ao iniciar o aplicativo" IsChecked="{Binding Settings.CompactOnStartup}"/>
     </StackPanel></Border>
     <Button Content="Salvar preferências" Command="{Binding SaveSettingsCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
     <WrapPanel Margin="0,16"><Button Content="Exportar configurações JSON" Command="{Binding ExportCommand}"/><Button Content="Importar configurações JSON" Command="{Binding ImportCommand}"/></WrapPanel>
     <TextBlock Text="Dados em %APPDATA%\RagnarokCompanion. Sem conexão com o jogo, captura de teclas ou automação. A compatibilidade com Gepard deve ser verificada nas regras do seu servidor; tela cheia exclusiva pode ocultar a janela." Style="{StaticResource Muted}"/>
    </StackPanel></Expander></StackPanel></ScrollViewer></UserControl>
