<UserControl x:Class="RagnarokCompanion.Views.BuildsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RagnarokCompanion.Views">
 <Grid><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel Margin="0,0,0,5"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Entrar com Google" Command="{Binding GoogleLoginCommand}" Visibility="{Binding IsSignedOut, Converter={StaticResource BoolVisibility}}" Padding="12,6"/><StackPanel Orientation="Horizontal" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolVisibility}}"><TextBlock Text="👤" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding AccountLabel}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" Foreground="#BAC3D5"/><Button Content="↪" ToolTip="Sair da conta" Command="{Binding GoogleLogoutCommand}" Background="Transparent" Padding="7,3" Margin="6,0,0,0"/></StackPanel></StackPanel><TextBlock Text="Builds" Style="{StaticResource Title}"/></DockPanel><TextBlock Text="{Binding GlobalLabel}" Foreground="{DynamicResource ThemeE9C77A}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,4"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding GlobalPercent, Mode=OneWay}" Height="7" Margin="0,0,0,7"/><TextBlock Text="{Binding ProgressCacheInfo}" FontSize="9" Foreground="#9AA6BF"/><TextBlock Text="{Binding RewardText}" FontSize="10" Foreground="#9AA6BF" TextWrapping="Wrap"/>
 <StackPanel Orientation="Horizontal" Margin="0,10,0,12"><RadioButton Content="Editor" GroupName="BuildSections" Style="{StaticResource NavItem}" IsChecked="{Binding Area, Converter={StaticResource PageIndex}, ConverterParameter=0}" Command="{Binding NavigateAreaCommand}" CommandParameter="0"/><RadioButton Content="Minhas Builds" GroupName="BuildSections" Style="{StaticResource NavItem}" Margin="8,3" IsChecked="{Binding Area, Converter={StaticResource PageIndex}, ConverterParameter=1}" Command="{Binding NavigateAreaCommand}" CommandParameter="1"/><RadioButton Content="Comunidade" GroupName="BuildSections" Style="{StaticResource NavItem}" IsChecked="{Binding Area, Converter={StaticResource PageIndex}, ConverterParameter=2}" Command="{Binding NavigateAreaCommand}" CommandParameter="2"/><RadioButton Content="Aprovações" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}" GroupName="BuildSections" Style="{StaticResource NavItem}" IsChecked="{Binding Area, Converter={StaticResource PageIndex}, ConverterParameter=3}" Command="{Binding NavigateAreaCommand}" CommandParameter="3"/></StackPanel>
 </StackPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6"/>
 <Grid><Border Visibility="{Binding IsEmptyEditor, Converter={StaticResource BoolVisibility}}" Background="#181D2C" CornerRadius="12" Padding="28"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Nenhuma build aberta" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Crie uma nova build ou abra uma em Minhas Builds." Foreground="#A8B1C5" Margin="0,12" TextWrapping="Wrap"/><Button Content="＋ Nova build" Command="{Binding NewCommand}" Style="{StaticResource Primary}"/></StackPanel></Border><views:BuildEditorView Visibility="{Binding IsEditor, Converter={StaticResource BoolVisibility}}"/><views:MyBuildsView Visibility="{Binding IsMyBuilds, Converter={StaticResource BoolVisibility}}"/><views:BuildModerationView Visibility="{Binding IsModeration, Converter={StaticResource BoolVisibility}}"/><views:BuildCommunityView Visibility="{Binding IsCommunity, Converter={StaticResource BoolVisibility}}"/></Grid>
 </DockPanel>
<Border Background="#D00C101B" Visibility="{Binding HasCommunityPreview, Converter={StaticResource BoolVisibility}}" Padding="16"><Border Background="{DynamicResource Theme181D2C}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="18" MaxWidth="600"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Fechar ✕" Command="{Binding CloseBuildPreviewCommand}"/><TextBlock Text="Ver build" FontSize="20" FontWeight="SemiBold"/></DockPanel><Button DockPanel.Dock="Bottom" Content="Copiar para meu editor" Command="{Binding CopyBuildPreviewCommand}" Style="{StaticResource Primary}" Margin="0,12,0,0" HorizontalAlignment="Left"/><views:BuildPreviewView DataContext="{Binding CommunityPreview}"/></DockPanel></Border></Border><Border Background="#D00C101B" Padding="18" Visibility="{Binding IsSlotEditorOpen, Converter={StaticResource BoolVisibility}}"><views:BuildSlotEditorView MaxWidth="500" VerticalAlignment="Center" MaxHeight="660"/></Border><Border Background="#D00C101B" Padding="20" Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolVisibility}}"><views:BuildReviewDialogView MaxWidth="1100"/></Border></Grid></UserControl>