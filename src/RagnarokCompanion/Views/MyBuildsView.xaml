<UserControl x:Class="RagnarokCompanion.Views.MyBuildsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="Consultar minhas publicações" Command="{Binding FetchOwnCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding OwnReviewSummary}" TextWrapping="Wrap" Foreground="#A8B1C5" Margin="0,8"/><Button Content="Carregar mais publicações · 20" Command="{Binding MoreOwnCommand}" Visibility="{Binding HasMoreOwn, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left"/><ItemsControl ItemsSource="{Binding CloudOwn}" MaxHeight="180"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><Button DockPanel.Dock="Right" Content="Editar publicação" Command="{Binding DataContext.OpenOwnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Right" Content="＋ Nova build" Command="{Binding NewCommand}" Style="{StaticResource Primary}"/><TextBlock Text="Minhas Builds" FontSize="22" FontWeight="SemiBold"/></DockPanel><TextBlock Text="Seus rascunhos e builds salvas neste computador." Style="{StaticResource Muted}"/><TextBlock Text="Entre com Google e consulte suas publicações para editá-las." Foreground="#7F8BA2" FontSize="10" TextWrapping="Wrap"/></StackPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="{DynamicResource Theme181D2C}" CornerRadius="12" Padding="26" Visibility="{Binding NoSaved, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Seu próximo projeto começa aqui" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Crie uma build no editor. O salvamento local mantém seu planejamento mesmo sem conexão." Style="{StaticResource Muted}"/></StackPanel></Border>
 <ItemsControl ItemsSource="{Binding SavedCards}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Theme181D2C}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,0,10"><StackPanel><DockPanel><Border DockPanel.Dock="Right" Background="{DynamicResource Theme30291B}" CornerRadius="5" Padding="8,4" Margin="12,0,0,0"><TextBlock Text="{Binding Status}" Foreground="{DynamicResource ThemeE9C77A}" FontSize="10"/></Border><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding Details}" Foreground="#BAC3D5" FontSize="12" Margin="0,6,0,3"/><TextBlock Text="{Binding Updated}" Foreground="#7F8BA2" FontSize="10"/>
 <WrapPanel Margin="0,9,0,0"><Button Content="Abrir build" Command="{Binding DataContext.LoadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Model}" Style="{StaticResource Primary}" Padding="11,6"/><Button Content="Duplicar" Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Model}" Padding="11,6"/><Button Content="Renomear" Command="{Binding RenameCommand}" Padding="11,6"/><Button Content="Excluir" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Model}" Background="Transparent" Foreground="#B6A4A4" Padding="11,6"/></WrapPanel>
 <DockPanel Visibility="{Binding Renaming, Converter={StaticResource BoolVisibility}}" Margin="0,7,0,0"><Button DockPanel.Dock="Right" Content="Salvar nome" Command="{Binding SaveNameCommand}" Padding="10,5"/><TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/></DockPanel>
 </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
 </DockPanel>
</UserControl>
