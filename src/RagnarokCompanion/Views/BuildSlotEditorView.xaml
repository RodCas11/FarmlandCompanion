<UserControl x:Class="RagnarokCompanion.Views.BuildSlotEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RagnarokCompanion.Views" Loaded="EditorLoaded" IsVisibleChanged="EditorVisibilityChanged">
<UserControl.Resources><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0,3"/></Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Padding" Value="7,4"/><Setter Property="MinWidth" Value="0"/><Setter Property="Margin" Value="0,3"/></Style><Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="7,3"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="Transparent"/></Style><Style x:Key="SearchPicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="MinWidth" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid MinHeight="30"><Border Background="#0C0F16" BorderBrush="#354057" BorderThickness="1" CornerRadius="5"/><TextBox x:Name="PART_EditableTextBox" Margin="7,4,25,4" Padding="0" BorderThickness="0" Background="Transparent" Foreground="#EDF0FA" IsReadOnly="{TemplateBinding IsReadOnly}" VerticalContentAlignment="Center"/><ToggleButton Width="24" HorizontalAlignment="Right" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="⌄" Foreground="#9AA6BF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#181D2C" BorderBrush="#354057" BorderThickness="1" CornerRadius="5" Padding="3" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="180"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources>
<UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelSlotDraftCommand}"/></UserControl.InputBindings>
<Border Background="#10131C" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="16"><DockPanel>
<DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="✕" Command="{Binding CancelSlotDraftCommand}" Style="{StaticResource SmallAction}" ToolTip="Cancelar e fechar"/><TextBlock Text="{Binding SlotDraft.SelectedSlot.Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancelar" Command="{Binding CancelSlotDraftCommand}" Padding="12,5"/><Button Content="Salvar" Click="SaveClick" Style="{StaticResource Primary}" Padding="16,5"/></WrapPanel>
<TextBlock DockPanel.Dock="Bottom" Text="{Binding SlotDraft.Message}" TextWrapping="Wrap" Foreground="{DynamicResource ThemeE9C77A}" FontSize="10" Margin="0,5,0,0"/>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding SlotDraft}">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition Width="64"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
<views:BuildItemPicker x:Name="ItemQuery" ItemsSource="{Binding Suggestions}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ItemChosen="SelectItem" ToolTip="Pesquisar item por nome ou ID" views:ItemTooltip.Model="{Binding SelectedSlot}"/>
<Button Grid.Column="1" Content="×" Command="{Binding ClearSlotCommand}" Style="{StaticResource SmallAction}" ToolTip="Limpar slot"/>
<TextBox Grid.Column="2" Visibility="{Binding CanRefineSlot, Converter={StaticResource BoolVisibility}}" Text="{Binding SelectedSlot.Refine, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" MaxLength="2" Margin="5,3" ToolTip="Refino"/>
<ComboBox Grid.Column="3" Visibility="{Binding CanGradeSlot, Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedSlot.Grade}" ToolTip="Grade"/>
</Grid>
<StackPanel Visibility="{Binding IsEquipmentSlot, Converter={StaticResource BoolVisibility}}">
<StackPanel Visibility="{Binding CanComponentSlot, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Cartas" Foreground="#9AA6BF" FontSize="11" Margin="0,12,0,4"/>
<ItemsControl ItemsSource="{Binding CardComponents}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Background="#0C0F16" Margin="0,2"><Button DockPanel.Dock="Right" Content="×" Command="{Binding RemoveCommand}" Style="{StaticResource SmallAction}"/><TextBlock Text="{Binding Name}" FontSize="11" Margin="8,5" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<views:BuildItemPicker Tag="Card" Text="{Binding CardQuery, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding CardResults}" ItemChosen="SelectComponent" ToolTip="Pesquisar carta por nome ou ID"/>
<TextBlock Text="Encantamentos · até +6" Foreground="#9AA6BF" FontSize="11" Margin="0,10,0,4"/>
<ItemsControl ItemsSource="{Binding EnchantComponents}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Background="#0C0F16" Margin="0,2"><Button DockPanel.Dock="Right" Content="×" Command="{Binding RemoveCommand}" Style="{StaticResource SmallAction}"/><TextBlock Text="{Binding Name}" FontSize="11" Margin="8,5" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<views:BuildItemPicker Tag="Enchant" Text="{Binding EnchantQuery, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding EnchantResults}" ItemChosen="SelectComponent" ToolTip="Pesquisar encantamento por nome ou ID · até +6"/>
</StackPanel><Expander Header="Random Options" IsExpanded="True" Margin="0,10,0,0"><StackPanel>
<ItemsControl ItemsSource="{Binding SlotOptions}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><Button DockPanel.Dock="Right" Content="×" Command="{Binding RemoveCommand}" Style="{StaticResource SmallAction}"/><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontSize="11" MaxLength="300"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding OptionSuggestions}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Name" ToolTip="Adicionar opção compatível" FontSize="11"/><Button Grid.Column="1" Content="＋" Command="{Binding AddOptionCommand}" Style="{StaticResource SmallAction}" ToolTip="Adicionar opção"/></Grid>
</StackPanel></Expander>
<Expander Visibility="{Binding CanComponentSlot, Converter={StaticResource BoolVisibility}}" Header="Avançado" FontSize="10" Foreground="#9AA6BF" Margin="0,8,0,0"><StackPanel><ComboBox ItemsSource="{Binding OptionProfiles}" SelectedItem="{Binding OptionProfile}" ToolTip="Perfil de forja"/><TextBlock Text="Cartas · IDs" FontSize="10"/><TextBox Text="{Binding SelectedSlot.CardsText, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/><TextBlock Text="Encantamentos · IDs" FontSize="10"/><TextBox Text="{Binding SelectedSlot.EnchantsText, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/></StackPanel></Expander>
</StackPanel></StackPanel></ScrollViewer></DockPanel></Border></UserControl>