<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SlotButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Height" Value="62" />
      <Setter Property="Background" Value="{DynamicResource Theme202739}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="SlotSurface" Background="{TemplateBinding Background}" BorderBrush="#343C50" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Selected}" Value="True">
                <Setter TargetName="SlotSurface" Property="BorderBrush" Value="{DynamicResource ThemeC29A4A}" />
                <Setter TargetName="SlotSurface" Property="BorderThickness" Value="2" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SlotSurface" Property="BorderBrush" Value="{DynamicResource ThemeE9C77A}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Theme30291B}" />
          <Setter Property="Foreground" Value="{DynamicResource ThemeE9C77A}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </ResourceDictionary>