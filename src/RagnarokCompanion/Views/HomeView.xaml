<UserControl x:Class="RagnarokCompanion.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RagnarokCompanion.Views">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Início" Style="{StaticResource Title}"/><TextBlock Text="Mina e MVPs, prontos para a próxima jogada." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,16,16"><StackPanel><TextBlock Text="Mineração" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding MiningStatus}" Foreground="{Binding MiningColor}" Margin="0,20,0,0"/><TextBlock Text="{Binding MiningCountdown}" Foreground="{Binding MiningColor}" FontFamily="Consolas" FontSize="48" Margin="0,2,0,12"/><TextBlock Text="{Binding MiningNext}" Style="{StaticResource Muted}"/><Button Content="Entrei na mina" Command="{Binding StartMiningCommand}" Style="{StaticResource Primary}" Visibility="{Binding MiningAvailable, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0"/>
    <Expander Header="Corrigir ciclo" Margin="0,14,0,0"><StackPanel><TextBlock Text="Entrada • dd/MM/aaaa HH:mm:ss" Style="{StaticResource Muted}" FontSize="11"/><TextBox Text="{Binding MiningEntry}"/><Button Content="Aplicar horário" Command="{Binding CorrectMiningCommand}"/><Button Content="Liberar mina / reiniciar" Command="{Binding ResetMiningCommand}"/><TextBlock Text="{Binding Exit, StringFormat=Saída prevista: {0}}" Style="{StaticResource Muted}"/></StackPanel></Expander>
   </StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="MVPs" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Pesquise, favorite e informe o horário da morte. Seus próximos respawns são calculados automaticamente." Style="{StaticResource Muted}" Margin="0,14"/><Button Content="Pesquisar MVP e registrar morte ↗" Command="{Binding Catalog.BrowseCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/></StackPanel></Border>
  </Grid>
  <Button Command="{Binding NavigateCommand}" CommandParameter="5" Background="{DynamicResource Theme181D2C}" HorizontalContentAlignment="Stretch" Margin="0,0,0,16" ToolTip="Abrir eventos"><StackPanel DataContext="{Binding Events}" HorizontalAlignment="Left"><TextBlock Text="PRÓXIMO EVENTO DO SERVIDOR ↗" FontSize="10" Foreground="#A58AEF"/><TextBlock Text="{Binding NextName}" FontSize="19" FontWeight="SemiBold"/><WrapPanel><TextBlock Text="{Binding NextTiming}" Margin="0,0,20,0"/><TextBlock Text="{Binding Countdown}" FontFamily="Consolas" Foreground="#71C8F4"/></WrapPanel><TextBlock Text="{Binding AlertStatus}" FontSize="11" Foreground="#9AA6BF"/></StackPanel></Button>
  <TextBlock Text="Próximos timers" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,12"/>
  <TextBlock Text="Nenhum evento agendado. Inicie a mina ou registre uma morte." Style="{StaticResource Muted}" Visibility="{Binding NoEvents, Converter={StaticResource BoolVisibility}}"/>
  <ItemsControl ItemsSource="{Binding UpcomingEvents}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Theme181D2C}" Padding="14,10" CornerRadius="8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="{Binding Color}" FontFamily="Consolas"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="#9AA6BF" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Remaining}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="19"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></ScrollViewer>
</UserControl>
