<UserControl x:Class="RagnarokCompanion.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RagnarokCompanion.Views">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Início" Style="{StaticResource Title}"/><TextBlock Text="Mina e MVPs, prontos para a próxima jogada." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,16,16"><StackPanel><TextBlock Text="Mineração" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding MiningStatus}" Foreground="{Binding MiningColor}" Margin="0,20,0,0"/><TextBlock Text="{Binding MiningCountdown}" Foreground="{Binding MiningColor}" FontFamily="Consolas" FontSize="48" Margin="0,2,0,12"/><TextBlock Text="{Binding MiningNext}" Style="{StaticResource Muted}"/><Button Content="Entrei na mina" Command="{Binding StartMiningCommand}" Style="{StaticResource Primary}" Visibility="{Binding MiningAvailable, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0"/>
    <Expander Header="Corrigir ciclo" Margin="0,14,0,0"><StackPanel><TextBlock Text="Entrada • dd/MM/aaaa HH:mm:ss" Style="{StaticResource Muted}" FontSize="11"/><TextBox Text="{Binding MiningEntry}"/><Button Content="Aplicar horário" Command="{Binding CorrectMiningCommand}"/><Button Content="Liberar mina / reiniciar" Command="{Binding ResetMiningCommand}"/><TextBlock Text="{Binding Exit, StringFormat=Saída prevista: {0}}" Style="{StaticResource Muted}"/></StackPanel></Expander>
   </StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel DataContext="{Binding Catalog}">
    <Grid><TextBlock Text="Registrar morte de MVP" FontSize="18" FontWeight="SemiBold"/><Button Content="Ver todos" Command="{Binding BrowseCommand}" HorizontalAlignment="Right" Padding="8,5" FontSize="11" Margin="0"/></Grid>
    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pesquisar MVP por nome" Margin="0,14,0,4"/>
    <TextBlock Text="Favoritos aparecem primeiro. Selecione um MVP." Style="{StaticResource Muted}" FontSize="11"/>
    <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" MaxHeight="135"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding FavoriteMark}" Foreground="#BEA7FF"/><TextBlock Grid.Column="1" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Button Content="Morreu agora" Command="{Binding DeathNowCommand}" IsEnabled="{Binding HasSelection}" Style="{StaticResource Primary}" Margin="0,10,0,0"/>
    <Expander Header="Informar outro horário" Margin="0,10,0,0"><StackPanel><TextBlock Text="dd/MM/aaaa HH:mm:ss • hora local" Style="{StaticResource Muted}" FontSize="11"/><TextBox Text="{Binding ManualDeath}"/><Button Content="Registrar horário" Command="{Binding ManualDeathCommand}" IsEnabled="{Binding HasSelection}"/></StackPanel></Expander>
    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
   </StackPanel></Border>
  </Grid>
  <TextBlock Text="Próximos eventos" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,12"/>
  <TextBlock Text="Nenhum evento agendado. Inicie a mina ou registre uma morte." Style="{StaticResource Muted}" Visibility="{Binding NoEvents, Converter={StaticResource BoolVisibility}}"/>
  <ItemsControl ItemsSource="{Binding UpcomingEvents}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#181D2C" Padding="14,10" CornerRadius="8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="{Binding Color}" FontFamily="Consolas"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="#9AA6BF" FontSize="11"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Remaining}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="19"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></ScrollViewer>
</UserControl>
