<UserControl x:Class="RagnarokCompanion.Views.EventSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="Notificações de eventos" FontSize="20" FontWeight="SemiBold"/>
  <WrapPanel><CheckBox Content="Ativar todos os alertas" IsChecked="{Binding Enabled}"/><CheckBox Content="Sons dos eventos" IsChecked="{Binding Sounds}"/></WrapPanel>
  <WrapPanel><CheckBox Content="Fantasminhas Dudu" IsChecked="{Binding DuduAlerts}"/><CheckBox Content="KVM" IsChecked="{Binding KvmAlerts}"/></WrapPanel>
  <TextBlock Text="Antecedências (selecione uma ou mais)" Style="{StaticResource Muted}"/>
  <ItemsControl ItemsSource="{Binding AdvanceOptions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <CheckBox Content="Mostrar próximo evento no compacto" IsChecked="{Binding ShowCompact}"/>
  <TextBlock Text="Fuso do servidor" Style="{StaticResource Muted}"/>
  <DockPanel><Button DockPanel.Dock="Right" Content="Salvar fuso" Command="{Binding SaveZoneCommand}"/><TextBox Text="{Binding TimeZoneInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Exemplos: America/Sao_Paulo, UTC, America/Manaus"/></DockPanel>
  <TextBlock Text="Alertas continuam na bandeja enquanto o aplicativo estiver aberto. O Windows pode silenciá-los; não há garantia sobre jogos em tela cheia exclusiva." Style="{StaticResource Muted}" FontSize="11"/>
 </StackPanel>
</UserControl>
