<UserControl x:Class="RagnarokCompanion.Views.BuildReviewDialogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RagnarokCompanion.Views" IsVisibleChanged="ReviewVisibilityChanged"><UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding CloseReviewCommand}"/></UserControl.InputBindings><Border Background="{DynamicResource Theme181D2C}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="12" Padding="20"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Fechar ✕" Command="{Binding CloseReviewCommand}"/><TextBlock Text="Revisar build" FontSize="21" FontWeight="SemiBold"/></DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock Text="Notas do ADM · públicas após aprovação" Foreground="{DynamicResource ThemeE9C77A}" FontSize="11"/><TextBox Text="{Binding AdminNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="65" MaxLength="2000" VerticalScrollBarVisibility="Auto" ToolTip="Comentário público do administrador"/><CheckBox IsChecked="{Binding ReviewConfirmed}"><TextBlock Text="Revisei a build e confirmo os critérios oficiais do estágio" TextWrapping="Wrap"/></CheckBox><TextBox Text="{Binding ModerationReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" ToolTip="Motivo obrigatório ao rejeitar"/><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="Rejeitar" Command="{Binding RejectBuildCommand}"/><Button Content="Aprovar build" Command="{Binding ApproveBuildCommand}" Style="{StaticResource Primary}"/></WrapPanel><TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource ThemeE9C77A}" TextWrapping="Wrap" Margin="0,5,12,0"/></DockPanel></StackPanel><ScrollViewer x:Name="ReviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><views:BuildPreviewView DataContext="{Binding ReviewPreview}" ExternalScroll="True"/><Expander Grid.Column="1" Header="Detalhes e validação" IsExpanded="True" Margin="18,5,8,0"><TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap" Foreground="#BAC3D5" FontSize="11"/></Expander></Grid></ScrollViewer></DockPanel></Border></UserControl>