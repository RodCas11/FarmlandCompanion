<UserControl x:Class="RagnarokCompanion.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="MVPs" Style="{StaticResource Title}"/><TextBlock Text="Pesquise, favorite e informe o horário da morte." Style="{StaticResource Muted}"/><Grid Margin="0,10,0,6"><TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="12,10" ToolTip="Buscar MVP..."/><TextBlock Text="Buscar MVP..." VerticalAlignment="Center" Margin="14,0,0,7" Foreground="#9AA6BF" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><WrapPanel><Button Content="Buscar no RagnaPlace" Command="{Binding IntegratedSearchCommand}" FontSize="11" Padding="8,4"/><TextBlock FontSize="11" Margin="8,4"><Hyperlink NavigateUri="https://ragnaplace.com" RequestNavigate="OpenAttribution">Dados: RagnaPlace</Hyperlink></TextBlock></WrapPanel><ProgressBar Height="2" IsIndeterminate="True" Visibility="{Binding OnlineBusy, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding OnlineStatus}" FontSize="11" Foreground="#9AA6BF" TextWrapping="Wrap" Margin="0,4"/><TextBlock Text="Favoritos primeiro" FontSize="11" Foreground="#A89BEF" Margin="0,0,0,6"/></StackPanel>
  <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" Background="#181D2C" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="8,3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#353152"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#7656DC"/><Setter TargetName="Selection" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{Binding FavoriteMark}" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Foreground="#BEA7FF" Background="Transparent" Padding="7,6" Margin="0" ToolTip="Favoritar / desfavoritar"/><DockPanel Grid.Column="1" Margin="8,0"><TextBlock DockPanel.Dock="Right" Text="{Binding SearchInfo}" Foreground="#9AA6BF" FontSize="10" Margin="12,0,0,0"/><TextBlock Text="{Binding DisplayName}" FontSize="15" TextTrimming="CharacterEllipsis"/></DockPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel Grid.Row="2" Margin="0,16,0,0"><Border Background="#181D2C" CornerRadius="8" Padding="16" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="{Binding DeathTitle}" FontSize="19" FontWeight="SemiBold"/><WrapPanel Margin="0,12,0,0"><StackPanel Width="180"><TextBlock Text="Horário da morte: HH:mm" FontSize="12"/><TextBox Text="{Binding DeathTime, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" FontSize="20" FontFamily="Consolas"/></StackPanel><CheckBox Content="Dia anterior" IsChecked="{Binding PreviousDay}" VerticalAlignment="Center" Margin="12,10"/><Button Content="Registrar morte" Command="{Binding RegisterDeathCommand}" Style="{StaticResource Primary}" VerticalAlignment="Center"/></WrapPanel><TextBlock Text="{Binding SelectedRespawnSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,9,0,0"/><TextBlock Text="{Binding SelectedRespawnSource}" Foreground="#9AA6BF" FontSize="10" Margin="0,4" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" Margin="0,8"/><Button Content="Configurações de MVPs ↗" Command="{Binding AdvancedCommand}" HorizontalAlignment="Left" Background="Transparent" Foreground="#9AA6BF" FontSize="11" Padding="0,4"/></StackPanel>
 </Grid>
</UserControl>
