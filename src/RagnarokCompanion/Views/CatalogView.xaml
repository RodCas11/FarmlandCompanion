<UserControl x:Class="RagnarokCompanion.Views.CatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RagnarokCompanion.Views" SizeChanged="CardsSizeChanged">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="MVPs" Style="{StaticResource Title}"/><TextBlock Text="Favorite seu alvo e registre a morte. Respawns oficiais do Farmland." Style="{StaticResource Muted}"/>
   <TextBlock Text="Buscar MVP por nome ou ID" Foreground="#9AA6BF" FontSize="11" Margin="0,9,0,0"/>
   <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Padding="12,9" Margin="0,10,0,7" ToolTip="Buscar MVP por nome ou ID"/>
   <DockPanel Margin="0,0,0,8"><TextBlock Text="★ Favoritos primeiro" Foreground="#E9C77A" FontSize="11"/><TextBlock DockPanel.Dock="Right" FontSize="10" HorizontalAlignment="Right"><Hyperlink NavigateUri="https://www.divine-pride.net" RequestNavigate="OpenAttribution">Sprites: Divine Pride ↗</Hyperlink></TextBlock></DockPanel>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType={x:Type local:CatalogView}}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="#171D2A" BorderBrush="#45402F" BorderThickness="1" CornerRadius="10" Padding="11" Margin="4" MinHeight="272"><StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" Content="{Binding FavoriteMark}" Command="{Binding FavoriteCommand}" ToolTip="Favoritar / desfavoritar" Foreground="#E9C77A" Background="Transparent" Padding="5,0" Margin="0" FontSize="19"/><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DockPanel>
    <TextBlock Text="{Binding Id}" Foreground="#7E8BA4" FontSize="10"/>
    <Grid Height="94" Margin="0,5"><TextBlock Text="☠" FontFamily="Segoe UI Symbol" FontSize="48" Foreground="#665332" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasSprite}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Sprite}" Stretch="Uniform" MaxHeight="94" MaxWidth="160" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
    <TextBlock Text="{Binding Map}" FontSize="11" Foreground="#B2BED2" TextTrimming="CharacterEllipsis" ToolTip="{Binding Map}"/>
    <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontSize="10" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding Countdown}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="20" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding Window}" Foreground="#AAB5CC" FontSize="10" MinHeight="15" TextTrimming="CharacterEllipsis" ToolTip="{Binding Window}"/>
    <UniformGrid Columns="2" Margin="0,7,0,0"><Button Content="Morreu agora" Command="{Binding NowCommand}" Padding="4,7" Margin="0,0,4,0" FontSize="10" Background="#A7863E" Foreground="#FFFFFF"/><Button Content="Informar horário" Command="{Binding TimeCommand}" Padding="4,7" Margin="0" FontSize="10"/></UniformGrid>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,8,0,0">
   <Border Background="#181D2C" CornerRadius="8" Padding="12" Visibility="{Binding ManualOpen, Converter={StaticResource BoolVisibility}}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="×" Command="{Binding CloseManualCommand}" Padding="5,0"/><TextBlock Text="{Binding DeathTitle}" FontSize="16" FontWeight="SemiBold"/></DockPanel><WrapPanel><StackPanel Width="135"><TextBlock Text="Horário da morte: HH:mm" FontSize="11"/><TextBox Text="{Binding DeathTime, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" FontSize="18" FontFamily="Consolas"/></StackPanel><CheckBox Content="Dia anterior" IsChecked="{Binding PreviousDay}" VerticalAlignment="Center" Margin="10,5"/><Button Content="Registrar morte" Command="{Binding RegisterDeathCommand}" Style="{StaticResource Primary}" VerticalAlignment="Center"/></WrapPanel><TextBlock Text="{Binding SelectedRespawnSummary}" TextWrapping="Wrap" FontSize="11" Margin="0,5"/></StackPanel></Border>
   <TextBlock Text="{Binding Status}" Foreground="#9AA6BF" TextWrapping="Wrap" FontSize="11" Margin="0,5"/><Button Content="Configurações de MVPs ↗" Command="{Binding AdvancedCommand}" HorizontalAlignment="Left" Background="Transparent" Foreground="#9AA6BF" FontSize="10" Padding="0,3"/>
  </StackPanel>
 </Grid>
</UserControl>
