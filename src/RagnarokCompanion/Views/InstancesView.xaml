<UserControl x:Class="RagnarokCompanion.Views.InstancesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RagnarokCompanion.Views" SizeChanged="CardsSizeChanged">
 <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Instâncias" Style="{StaticResource Title}"/><TextBlock Text="Terminou a instância? Registre o término e acompanhe a próxima disponibilidade." Style="{StaticResource Muted}"/><WrapPanel><CheckBox Content="Avisar quando liberar" IsChecked="{Binding Alerts}"/><CheckBox Content="Som das instâncias" IsChecked="{Binding Sounds}"/><Button Content="Limpar timers" Command="{Binding ClearAllCommand}" Padding="9,5" FontSize="11"/></WrapPanel></StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Foreground="#9AA6BF" TextWrapping="Wrap" FontSize="11" Margin="0,8"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType={x:Type local:InstancesView}}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
   <Border Background="{DynamicResource Theme181D2C}" BorderBrush="{DynamicResource Theme756039}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="4"><StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" Content="↺" ToolTip="Limpar somente este timer" Command="{Binding ClearCommand}" Background="Transparent" Padding="4,0" Margin="4,0,0,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/></DockPanel>
    <Grid Height="100" Margin="0,7" ToolTip="{Binding NpcHint}"><TextBlock Text="◇" FontSize="42" Foreground="#756A55" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasSprite}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Sprite}" Stretch="Uniform" MaxHeight="100" MaxWidth="160" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
    <TextBlock Text="{Binding Cooldown}" Foreground="#9AA6BF" FontSize="11"/><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" Margin="0,8,0,0" FontSize="12"/><TextBlock Text="{Binding Countdown}" Foreground="{Binding Color}" FontFamily="Consolas" FontSize="25"/><TextBlock Text="{Binding Available}" Foreground="#9AA6BF" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,7"/>
    <UniformGrid Columns="2"><Button Content="Terminei agora" Command="{Binding NowCommand}" Style="{StaticResource Primary}" Padding="4,7" FontSize="10" Margin="0,0,5,0"/><Button Content="Informar horário" Command="{Binding TimeCommand}" Padding="4,7" FontSize="10" Margin="0"/></UniformGrid>
    <StackPanel Visibility="{Binding ManualOpen, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0"><TextBlock Text="Término • HH:mm (horário local)" FontSize="11"/><TextBox Text="{Binding ManualTime, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" FontFamily="Consolas" FontSize="18"/><CheckBox Content="Dia anterior" IsChecked="{Binding Yesterday}"/><Button Content="Salvar término" Command="{Binding SaveTimeCommand}" Padding="8,5"/></StackPanel>
   </StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </DockPanel>
</UserControl>
