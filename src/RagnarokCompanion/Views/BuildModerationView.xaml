<UserControl x:Class="RagnarokCompanion.Views.BuildModerationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Aprovação de Builds" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Abra uma solicitação para revisar os equipamentos e os critérios." Foreground="#A8B1C5" Margin="0,8"/><Button Content="Atualizar pendentes" Command="{Binding FetchPendingCommand}" HorizontalAlignment="Left"/></StackPanel><Button DockPanel.Dock="Bottom" Content="Carregar mais · 20 pedidos" Command="{Binding MorePendingCommand}" Visibility="{Binding HasMorePending, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left"/><ListBox Margin="0,10" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" ItemsSource="{Binding PendingBuilds}"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Theme181D2C}" CornerRadius="8" Padding="12" Margin="0,3"><DockPanel><Button DockPanel.Dock="Right" Content="Revisar build" Command="{Binding DataContext.OpenReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Primary}"/><StackPanel><TextBlock Text="{Binding Build.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Foreground="#A8B1C5" Margin="0,5"><Run Text="{Binding Build.ClassId, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Build.Stage, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Build.Purpose, Mode=OneWay}"/></TextBlock></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></UserControl>