<UserControl x:Class="RagnarokCompanion.Views.BuildPreviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RagnarokCompanion.Views">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BuildEquipmentStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources><ScrollViewer x:Name="PreviewScroll" PreviewMouseWheel="ScrollPreview" Focusable="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4" MaxWidth="520" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Foreground="#A8B1C5" Margin="0,4"><Run Text="Criado por: "/><Run Text="{Binding PreviewAuthor, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding BuildDetails}" Foreground="{DynamicResource ThemeE9C77A}" Margin="0,8" TextWrapping="Wrap"/>            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><RadioButton Content="Equipamentos" Style="{StaticResource NavItem}" Padding="9,6" IsChecked="{Binding IsNormalGroup, Mode=OneWay}" Command="{Binding SwitchEquipmentGroupCommand}" CommandParameter="Normal"/><RadioButton Content="Visuais / Shadows" Style="{StaticResource NavItem}" Padding="9,6" IsChecked="{Binding IsVisualGroup, Mode=OneWay}" Command="{Binding SwitchEquipmentGroupCommand}" CommandParameter="Extras"/></StackPanel>
            <Border Background="{DynamicResource Theme181D2C}" CornerRadius="12" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Padding="2">
              <Grid Height="350" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="5" VerticalAlignment="Center" IsHitTestVisible="False">
                  <Image Source="{Binding ClassSprite}" Width="92" Height="152" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  <TextBlock Text="{Binding SelectedClass.Name}" Foreground="{DynamicResource ThemeE9C77A}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Text="Sprite: iRO Wiki / Gravity" FontSize="8" Foreground="#75809A" HorizontalAlignment="Center" Margin="0,6" />
                </StackPanel>
                <ItemsControl Grid.ColumnSpan="3" Grid.RowSpan="5" ItemsSource="{Binding BoardSlots}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="96"/>
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition />
                          <RowDefinition />
                          <RowDefinition />
                          <RowDefinition />
                          <RowDefinition />
                        </Grid.RowDefinitions>
                      </Grid>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                      <Setter Property="Grid.Row" Value="{Binding BoardRow}" />
                      <Setter Property="Grid.Column" Value="{Binding BoardColumn}" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button  Style="{StaticResource SlotButton}" HorizontalContentAlignment="Stretch" views:ItemTooltip.Model="{Binding}">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontSize="9" Foreground="#9AA6BF" />
                          <DockPanel>
                            <Image Source="{Binding Image}" Width="26" Height="26" Margin="0,0,4,0" />
                            <StackPanel>
                              <TextBlock Text="{Binding ItemName}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="28" />
                              <TextBlock Text="{Binding Summary}" FontSize="8" Foreground="#9AA6BF" />
                            </StackPanel>
                          </DockPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
<Border DataContext="{Binding PetSlot}" Background="{DynamicResource Theme202739}" CornerRadius="8" Padding="8" Margin="0,8" views:ItemTooltip.Model="{Binding}"><DockPanel><Image Source="{Binding Image}" Width="28" Height="28" Margin="0,0,8,0"/><StackPanel><TextBlock Text="Ovo de Mascote · opcional" FontSize="10" Foreground="#9AA6BF"/><TextBlock Text="{Binding ItemName}" TextWrapping="Wrap"/></StackPanel></DockPanel></Border><TextBlock Text="Atributos" FontWeight="SemiBold" Margin="0,12,0,6"/><ItemsControl ItemsSource="{Binding Stats}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Name}" Foreground="#9AA6BF"/><TextBlock Text="{Binding Value}" FontWeight="SemiBold"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Visibility="{Binding HasAdminNotes, Converter={StaticResource BoolVisibility}}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,8"><StackPanel><TextBlock Text="Notas do ADM" FontWeight="SemiBold" Foreground="{DynamicResource ThemeE9C77A}"/><TextBlock Text="{Binding PreviewAdminNotes}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="Anotações" FontWeight="SemiBold" Margin="0,12,0,6"/><TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="#A8B1C5"/></StackPanel></ScrollViewer></UserControl>