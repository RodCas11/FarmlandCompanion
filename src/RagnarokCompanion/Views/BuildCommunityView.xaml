<UserControl x:Class="RagnarokCompanion.Views.BuildCommunityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Comunidade" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Catálogo local · sincronização automática a cada 12 horas ou manual" Style="{StaticResource Muted}"/><TextBox Text="{Binding CommunityQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pesquisar no cache local"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding CommunityClasses}" SelectedItem="{Binding CommunityClass}"/><ComboBox Grid.Column="1" ItemsSource="{Binding CommunityStages}" SelectedItem="{Binding CommunityStage}"/><ComboBox Grid.Column="2" ItemsSource="{Binding CommunityPurposes}" SelectedItem="{Binding CommunityPurpose}"/></Grid><WrapPanel><ComboBox ItemsSource="{Binding CommunityOrders}" SelectedItem="{Binding CommunityOrder}" Width="170"/><Button Content="Buscar / sincronizar" Command="{Binding SyncCommand}" ToolTip="Sincronização manual a cada 5 minutos"/></WrapPanel><TextBlock Text="{Binding CommunityStatus}" Style="{StaticResource Muted}" FontSize="10"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Visibility="{Binding NoCommunity, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource Theme181D2C}" Padding="20" CornerRadius="10" Margin="0,10"><StackPanel><TextBlock Text="Nenhuma build nesta consulta local" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Use Buscar / sincronizar para consultar a comunidade." Style="{StaticResource Muted}"/></StackPanel></Border><ItemsControl ItemsSource="{Binding CommunityCards}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Theme181D2C}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" Foreground="#A8B1C5" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Author}" Foreground="#BAC3D5" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="{Binding StarText}" Foreground="{Binding StarColor}" Background="Transparent" Padding="8,3" IsEnabled="{Binding CanStar}" Command="{Binding DataContext.ToggleStarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Model}"/><Button Content="Editar minha build" Visibility="{Binding IsOwner, Converter={StaticResource BoolVisibility}}" Command="{Binding DataContext.EditOwnedCommunityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Model}" Padding="10,4"/><Button Content="Ver build" Command="{Binding DataContext.ViewBuildCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Model}" Style="{StaticResource Primary}" Padding="12,5"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Carregar mais · 20 resultados" Command="{Binding MoreCommunityCommand}" Visibility="{Binding HasMoreCommunity, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></DockPanel></UserControl>