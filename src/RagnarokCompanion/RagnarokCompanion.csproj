<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FarmlandCompanion</AssemblyName><RootNamespace>RagnarokCompanion</RootNamespace>
    <Version>4.1.0</Version>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Data/mvp-seed.json"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/AppIcon.ico"/></ItemGroup>
</Project>
