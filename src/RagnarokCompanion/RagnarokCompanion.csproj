<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns process DPI via the manifest. WinForms supplies NotifyIcon only;
         its ApplicationConfiguration.Initialize/Application.Run entry point is not used. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>FarmlandCompanion</AssemblyName><RootNamespace>RagnarokCompanion</RootNamespace>
    <Version>4.6.0</Version>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Data/mvp-seed.json"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../spotlights_farmland_completo.json" LogicalName="RagnarokCompanion.Data.spotlights_farmland_completo.json"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/AppIcon.ico"/></ItemGroup>
</Project>
